&lt;p&gt;\uc0\u1040 \u1083 \u1091 \u1096 \u1090 \u1072  \'96 \u1101 \u1090 \u1086  \u1078 \u1080 \u1074 \u1086 \u1087 \u1080 \u1089 \u1085 \u1099 \u1081  \u1082 \u1091 \u1088 \u1086 \u1088 \u1090  \u1085 \u1072  \u1095 \u1077 \u1088 \u1085 \u1086 \u1084 \u1086 \u1088 \u1089 \u1082 \u1086 \u1084  \u1087 \u1086 \u1073 \u1077 \u1088 \u1077 \u1078 \u1100 \u1077  \u1050 \u1088 \u1099 \u1084 \u1072 . \u1047 \u1076 \u1077 \u1089 \u1100  \u1091 \u1085 \u1080 \u1082 \u1072 \u1083 \u1100 \u1085 \u1099 \u1081  &lt;strong&gt;\u1084 \u1103 \u1075 \u1082 \u1080 \u1081  \u1080  \u1094 \u1077 \u1083 \u1077 \u1073 \u1085 \u1099 \u1081  \u1084 \u1080 \u1082 \u1088 \u1086 \u1082 \u1083 \u1080 \u1084 \u1072 \u1090 &lt;/strong&gt; \u1073 \u1083 \u1072 \u1075 \u1086 \u1076 \u1072 \u1088 \u1103  \u1094 \u1080 \u1088 \u1082 \u1091 \u1083 \u1103 \u1094 \u1080 \u1080  \u1074 \u1086 \u1079 \u1076 \u1091 \u1096 \u1085 \u1099 \u1093  \u1084 \u1072 \u1089 \u1089  \u1089  \u1084 \u1086 \u1088 \u1089 \u1082 \u1086 \u1075 \u1086  \u1087 \u1086 \u1073 \u1077 \u1088 \u1077 \u1078 \u1100 \u1103  \u1080  \u1075 \u1086 \u1088  \u1080  \u1084 \u1085 \u1086 \u1078 \u1077 \u1089 \u1090 \u1074 \u1091  \u1074 \u1077 \u1095 \u1085 \u1086 \u1079 \u1077 \u1083 \u1077 \u1085 \u1099 \u1093  \u1093 \u1074 \u1086 \u1081 \u1085 \u1099 \u1093  \u1085 \u1072 \u1089 \u1072 \u1078 \u1076 \u1077 \u1085 \u1080 \u1081 . \u1048 \u1079 \u1083 \u1102 \u1073 \u1083 \u1077 \u1085 \u1085 \u1086 \u1077  \u1084 \u1077 \u1089 \u1090 \u1086  \u1086 \u1090 \u1076 \u1099 \u1093 \u1072  \u1080  \u1076 \u1086 \u1089 \u1091 \u1075 \u1072  \u1078 \u1080 \u1090 \u1077 \u1083 \u1077 \u1081  \u1080  \u1075 \u1086 \u1089 \u1090 \u1077 \u1081  \u1075 \u1086 \u1088 \u1086 \u1076 \u1072  \u8210  \u1101 \u1090 \u1086  &lt;strong&gt;\u1087 \u1088 \u1086 \u1075 \u1091 \u1083 \u1086 \u1095 \u1085 \u1072 \u1103  \u1085 \u1072 \u1073 \u1077 \u1088 \u1077 \u1078 \u1085 \u1072 \u1103 &lt;/strong&gt; \u1087 \u1088 \u1086 \u1090 \u1103 \u1078 \u1077 \u1085 \u1085 \u1086 \u1089 \u1090 \u1100 \u1102  7 \u1082 \u1084  \u1089  \u1088 \u1072 \u1079 \u1074 \u1083 \u1077 \u1095 \u1077 \u1085 \u1080 \u1103 \u1084 \u1080  \u1076 \u1083 \u1103  \u1076 \u1077 \u1090 \u1077 \u1081  \u1080  \u1074 \u1079 \u1088 \u1086 \u1089 \u1083 \u1099 \u1093 . \u1063 \u1080 \u1089 \u1090 \u1077 \u1081 \u1096 \u1080 \u1077  \u1084 \u1077 \u1083 \u1082 \u1086 \u1075 \u1072 \u1083 \u1077 \u1095 \u1085 \u1099 \u1077  &lt;strong&gt;\u1087 \u1083 \u1103 \u1078 \u1080  \u1089  \u1087 \u1088 \u1086 \u1079 \u1088 \u1072 \u1095 \u1085 \u1086 \u1081  \u1074 \u1086 \u1076 \u1086 \u1081 &lt;/strong&gt;, \u1087 \u1088 \u1080 \u1088 \u1086 \u1076 \u1085 \u1099 \u1084  \u1094 \u1077 \u1083 \u1077 \u1073 \u1085 \u1099 \u1084  \u1082 \u1074 \u1072 \u1088 \u1094 \u1077 \u1074 \u1099 \u1084  \u1087 \u1077 \u1089 \u1082 \u1086 \u1084  \u1080  \u1087 \u1086 \u1089 \u1090 \u1077 \u1087 \u1077 \u1085 \u1085 \u1099 \u1084  \u1079 \u1072 \u1093 \u1086 \u1076 \u1086 \u1084  \u1074  \u1084 \u1086 \u1088 \u1077  \u1080 \u1076 \u1077 \u1072 \u1083 \u1100 \u1085 \u1086  \u1087 \u1086 \u1076 \u1093 \u1086 \u1076 \u1103 \u1090  \u1082 \u1072 \u1082  \u1076 \u1083 \u1103  \u1074 \u1079 \u1088 \u1086 \u1089 \u1083 \u1099 \u1093 , \u1090 \u1072 \u1082  \u1076 \u1083 \u1103  \u1084 \u1072 \u1083 \u1099 \u1096 \u1077 \u1081 .&lt;br&gt;&amp;nbsp;&lt;br&gt;\u1042  \u1046 \u1050  \u1087 \u1088 \u1077 \u1076 \u1091 \u1089 \u1084 \u1086 \u1090 \u1088 \u1077 \u1085 \u1099  \u1072 \u1082 \u1074 \u1072 \u1079 \u1086 \u1085 \u1099 , &lt;strong&gt;\u1073 \u1072 \u1085 \u1085 \u1099 \u1081  \u1082 \u1086 \u1084 \u1087 \u1083 \u1077 \u1082 \u1089  \u1080  \u1084 \u1077 \u1076 \u1080 \u1094 \u1080 \u1085 \u1089 \u1082 \u1080 \u1081  \u1089 \u1077 \u1082 \u1090 \u1086 \u1088 &lt;/strong&gt;. \u1056 \u1077 \u1089 \u1090 \u1086 \u1088 \u1072 \u1085 \u1085 \u1099 \u1081  \u1089 \u1077 \u1082 \u1090 \u1086 \u1088  \u1086 \u1073 \u1089 \u1083 \u1091 \u1078 \u1080 \u1090  \u1074  \u1083 \u1102 \u10