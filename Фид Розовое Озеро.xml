&lt;p&gt;\uc0\u1055 \u1088 \u1086 \u1089 \u1090 \u1086  \u1075 \u1091 \u1083 \u1103 \u1103  \u1087 \u1086  \u1093 \u1074 \u1086 \u1081 \u1085 \u1086 \u1084 \u1091  \u1087 \u1072 \u1088 \u1082 \u1091 , \u1074 \u1099  \u1087 \u1086 \u1075 \u1088 \u1091 \u1078 \u1072 \u1077 \u1090 \u1077 \u1089 \u1100  \u1074  \u1082 \u1083 \u1080 \u1084 \u1072 \u1090 \u1086 \u1083 \u1077 \u1095 \u1077 \u1085 \u1080 \u1077 . \u1057 \u1086 \u1074 \u1077 \u1088 \u1096 \u1072 \u1103  \u1087 \u1088 \u1086 \u1073 \u1077 \u1078 \u1082 \u1080  &lt;strong&gt;\u1087 \u1086  \u1075 \u1086 \u1088 \u1085 \u1099 \u1084  \u1090 \u1077 \u1088 \u1088 \u1077 \u1085 \u1082 \u1091 \u1088 \u1072 \u1084 &lt;/strong&gt;, \u1085 \u1077 \u1087 \u1088 \u1080 \u1085 \u1091 \u1078 \u1076 \u1105 \u1085 \u1085 \u1086  \u1087 \u1088 \u1080 \u1074 \u1099 \u1082 \u1072 \u1077 \u1090 \u1077  \u1082  \u1091 \u1074 \u1077 \u1083 \u1080 \u1095 \u1077 \u1085 \u1080 \u1102  \u1092 \u1080 \u1079 \u1080 \u1095 \u1077 \u1089 \u1082 \u1080 \u1093  \u1085 \u1072 \u1075 \u1088 \u1091 \u1079 \u1086 \u1082 . \u1045 \u1089 \u1083 \u1080  \u1087 \u1086 \u1075 \u1086 \u1076 \u1072  \u1076 \u1086 \u1078 \u1076 \u1083 \u1080 \u1074 \u1072 \u1103 , \u1087 \u1086 \u1079 \u1072 \u1085 \u1080 \u1084 \u1072 \u1090 \u1100 \u1089 \u1103  \u1092 \u1080 \u1090 \u1085 \u1077 \u1089 \u1086 \u1084  \u1084 \u1086 \u1078 \u1085 \u1086  &lt;strong&gt;\u1074  \u1089 \u1087 \u1086 \u1088 \u1090 \u1079 \u1072 \u1083 \u1077 &lt;/strong&gt;. \u1053 \u1091  \u1072  &lt;strong&gt;\u1081 \u1086 \u1075 \u1072 -\u1094 \u1077 \u1085 \u1090 \u1088 &lt;/strong&gt; &lt;strong&gt;\u1089  \u1074 \u1080 \u1076 \u1086 \u1084  \u1085 \u1072  \u1050 \u1088 \u1099 \u1084 \u1089 \u1082 \u1080 \u1077  \u1075 \u1086 \u1088 \u1099 &lt;/strong&gt; \u8210  \u1101 \u1090 \u1086  \u1080 \u1079 \u1102 \u1084 \u1080 \u1085 \u1082 \u1072  \u1082 \u1086 \u1084 \u1087 \u1083 \u1077 \u1082 \u1089 \u1072 .&lt;/p&gt;</complex-description>\
    <building-description>&lt;p&gt;\uc0\u1046 \u1080 \u1083 \u1086 \u1081  \u1082 \u1086 \u1084 \u1087 \u1083 \u1077 \u1082 \u1089 , \u1086 \u1082 \u1088 \u1091 \u1078 \u1077 \u1085 \u1085 \u1099 \u1081  \u1082 \u1088 \u1099 \u1084 \u1089 \u1082 \u1080 \u1084 \u1080  \u1089 \u1086 \u1089 \u1085 \u1072 \u1084 \u1080  \u1080  \u1075 \u1086 \u1088 \u1072 \u1084 \u1080 , \u1088 \u1072 \u1089 \u1087 \u1086 \u1083 \u1086 \u1078 \u1080 \u1083 \u1089 \u1103  \u1074  \u1091 \u1077 \u1076 \u1080 \u1085 \u1077 \u1085 \u1085 \u1086 \u1084  \u1091 \u1075 \u1086 \u1083 \u1082 \u1077  &lt;strong&gt;\u1075 \u1086 \u1088 \u1086 \u1076 \u1072  \u1040 \u1083 \u1091 \u1096 \u1090 \u1072 &lt;/strong&gt; \u1085 \u1072  \u1070 \u1078 \u1085 \u1086 \u1084  \u1073 \u1077 \u1088 \u1077 \u1075 \u1091  \u1050 \u1088 \u1099 \u1084 \u1072 . \u1055 \u1088 \u1086 \u1077 \u1082 \u1090  \u1089 \u1086 \u1095 \u1077 \u1090 \u1072 \u1077 \u1090  \u1074  \u1089 \u1077 \u1073 \u1077  \u1089 \u1086 \u1074 \u1088 \u1077 \u1084 \u1077 \u1085 \u1085 \u1086 \u1077  \u1078 \u1080 \u1083 \u1100 \u1105  \u1080  &lt;strong&gt;\u1087 \u1086 \u1083 \u1085 \u1099 \u1081  \u1089 \u1087 \u1077 \u1082 \u1090 \u1088  \u1082 \u1091 \u1088 \u1086 \u1088 \u1090 \u1085 \u1086 \u1081  \u1080 \u1085 \u1092 \u1088 \u1072 \u1089 \u1090 \u1088 \u1091 \u1082 \u1090 \u1091 \u1088 \u1099 &lt;/strong&gt;. \u1050 \u1086 \u1084 \u1092 \u1086 \u1088 \u1090 \u1085 \u1072 \u1103  \u1090 \u1088 \u1072 \u1085 \u1089 \u1087 \u1086 \u1088 \u1090 \u1085 \u1072 \u1103  \u1076 \u1086 \u1089 \u1090 \u1091 \u1087 \u1085 \u1086 \u1089 \u1090 \u1100  \'96 \u1087 \u1088 \u1103 \u1084 \u1072 \u1103  \u1090 \u1088 \u1072 \u1089 \u1089 \u1072  \u1074  \u1072 \u1101 \u1088 \u1086 \u1087 \u1086 \u1088 \u1090  \u1057 \u1080 \u1084 \u1092 \u1077 \u1088 \u1086 \u1087 \u1086 \u1083 \u1100  \u1080  \u1074  \u1050 \u1077 \u1088 \u1095 \u1100  \'96 \u1085 \u1072  \u1082 \u1088 \u1099 \u1084 \u1089 \u1082 \u1080 \u1081  \u1084 \u1086 \u1089 \u1090  \u1087 \u1086